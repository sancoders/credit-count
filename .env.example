# Supabase project settings -> API. Both values are public by design:
# they ship to the browser in any Supabase app and are safe to expose.
# Row Level Security, not key secrecy, is what protects user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by `npm run verify:rls` and `npm run seed:users`, never by the app.
# These are ordinary end-user credentials, not service keys: the scripts sign in
# exactly like a browser would, which is the point of the test.
VERIFY_RIDER_EMAIL=
VERIFY_RIDER_PASSWORD=
VERIFY_RIVAL_EMAIL=
VERIFY_RIVAL_PASSWORD=
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY entry here.
# This project never uses one: the catalogue is seeded through versioned SQL
# migrations and test accounts are created through the public sign-up endpoint.
