# Supabase project settings -> API.
#
# Note the ABSENCE of a NEXT_PUBLIC_ prefix. That prefix is what inlines a value
# into the browser bundle, and nothing in the browser needs these: every
# Supabase call in this app happens in a Server Component, a Server Action or
# proxy.ts. The publishable key would be safe to expose - it is public by design
# and RLS, not key secrecy, protects the data - but it never has to be.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Used only by `npm run verify:rls` and `npm run seed:demo`, never by the app.
# These are ordinary end-user credentials, not service keys: the scripts sign in
# exactly like a browser would, which is the point of the test.
DEMO_RIDER_EMAIL=
DEMO_RIDER_PASSWORD=
DEMO_RIVAL_EMAIL=
DEMO_RIVAL_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY entry here.
# This project never uses one: the catalogue is seeded through versioned SQL
# migrations and every account is created through the public sign-up endpoint.
